DEMO_APP_NAME=OntoAgentQA Demo API
DEMO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_AGENT_MAX_ITERATIONS=15
DEMO_AGENT_TEMPERATURE=0
# DEMO_AGENT_MAX_TOKENS=

# The backend also reads the repository root .env automatically.
# You can override agent/service variables here for the demo if needed.
OPENROUTER_API_KEY=...
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PROVIDER_ONLY=cloudflare

GRAPHDB_ENDPOINT=...
GRAPHDB_TIMEOUT=30

ELASTICSEARCH_URL=http://localhost:9200
ENTITY_INDEX=entity_index
SCHEMA_INDEX=schema_index
HYBRID_SEARCH_ENABLED=true

